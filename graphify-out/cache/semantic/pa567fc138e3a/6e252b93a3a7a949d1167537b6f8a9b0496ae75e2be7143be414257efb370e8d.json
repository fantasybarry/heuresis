{"nodes": [{"id": "nomisma_api_contract_implementation_contract", "label": "Nomisma implementation contract", "file_type": "document", "source_file": "nomisma/API_CONTRACT.md", "source_location": "L1-L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python 3.9+ standard-library backend serves a dependency-free frontend and SQLite workspace. Daily scans validate before asynchronous execution, permit one scan at a time and never substitute demo data for failed real scans."}, {"id": "nomisma_api_contract_research_jobs", "label": "Asynchronous diagnostics and candidate discovery", "file_type": "concept", "source_file": "nomisma/API_CONTRACT.md", "source_location": "L56-L68", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Diagnostics/discovery return HTTP 202 job envelopes; one research action runs at a time and only 32 recent jobs remain in memory. Discovery persists settings and successful results, enriches at most 500 candidates and bounds quote refresh to batches of 50 with two concurrent requests."}, {"id": "nomisma_api_contract_workspace_backup_restore", "label": "Validated SQLite backup and restore", "file_type": "rationale", "source_file": "nomisma/API_CONTRACT.md", "source_location": "L51,L75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backup downloads a consistent snapshot. Restore accepts at most 128 MB, requires idle research services, validates table rows, saves a safety backup and leaves monitoring stopped. Frozen planner results are reproduced from original evidence/settings."}, {"id": "nomisma_api_contract_health_identity", "label": "Local service identity verification", "file_type": "rationale", "source_file": "nomisma/API_CONTRACT.md", "source_location": "L56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The health endpoint exposes app identity, version and data directory so a launcher reuses only the intended Nomisma workspace."}, {"id": "nomisma_api_contract_planner_api", "label": "Immutable planner API", "file_type": "concept", "source_file": "nomisma/API_CONTRACT.md", "source_location": "L45-L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Original alert analysis is frozen. Current reanalysis requires a running matching source/feed/symbol and never rewrites the original or starts monitoring. Complete account confirmation controls timestamps; planning failures preserve alerts."}, {"id": "nomisma_api_contract_local_api_boundary", "label": "Loopback and origin protection", "file_type": "rationale", "source_file": "nomisma/API_CONTRACT.md", "source_location": "L19,L23,L41,L79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The service binds to loopback, rejects foreign mutation origins and keeps credentials server-side. Static serving must not expose keys/data; provider traffic uses fixed hosts and real failures remain explicit."}], "edges": [{"source": "nomisma_api_contract_implementation_contract", "target": "nomisma_api_contract_research_jobs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "nomisma/API_CONTRACT.md", "source_location": "L54-L68", "weight": 1}, {"source": "nomisma_api_contract_implementation_contract", "target": "nomisma_api_contract_workspace_backup_restore", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "nomisma/API_CONTRACT.md", "source_location": "L75", "weight": 1}, {"source": "nomisma_api_contract_implementation_contract", "target": "nomisma_api_contract_health_identity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "nomisma/API_CONTRACT.md", "source_location": "L56", "weight": 1}, {"source": "nomisma_api_contract_implementation_contract", "target": "nomisma_api_contract_plann