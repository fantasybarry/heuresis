# Copy this file to .env and add your own Alpaca credentials locally.
# Keep .env private. Restart Nomisma after changing it.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# iex = one exchange; sip = consolidated US data, subject to account entitlement.
ALPACA_FEED=iex
# true for paper-account credentials; false for live-account credentials.
# Nomisma only reads assets, calendars, and price history. It never places orders.
ALPACA_PAPER=true
# Optional: Financial Modeling Prep API access to /stable/shares-float.
# Without this key, enter a dated manual float or leave float unavailable.
FMP_API_KEY=
# Optional: Massive (formerly Polygon) key for the offline discovery study.
MASSIVE_API_KEY=
# Optional: share one Alpaca stream between workstations (Alpaca allows one stream per key).
# Pool machine: python run.py --pool --port 8770. Workstations: NOMISMA_POOL=pool-host:8770.
# Same token on every machine, 16+ characters. If the pool machine also runs the app,
# set NOMISMA_POOL=127.0.0.1:8770 there too, or its app opens a second stream and gets error 406.
NOMISMA_POOL=
NOMISMA_POOL_TOKEN=
